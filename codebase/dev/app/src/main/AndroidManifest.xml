<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MenuApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_infinity_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_infinity_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.MenuApp"
        tools:targetApi="31">
        <activity android:name=".admin.AdminActivity" android:exported="false" android:theme="@style/Theme.MenuApp.Auth" />
        <activity android:name=".calling.VoiceLobbyActivity" android:exported="false" android:screenOrientation="portrait" android:theme="@style/Theme.MenuApp.Auth" />
        <activity android:name=".reference.ReferenceActivity" android:exported="false" android:theme="@style/Theme.MenuApp.Auth" />
        
        <activity
            android:name=".auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MenuApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp" />
        
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp.Auth"
            android:windowSoftInputMode="adjustResize" />
        
        <activity
            android:name=".auth.OTPVerificationActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp.Auth"
            android:windowSoftInputMode="adjustResize" />
        
        <activity
            android:name=".auth.LanguageSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp.Auth" android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp.Auth"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".home.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp" />
        
        <activity
            android:name=".dashboard.MaleDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp" />
        
        <activity
            android:name=".dashboard.FemaleDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp" />
        
        <activity
            android:name=".discover.DiscoverActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp" />
        
        <activity
            android:name=".calling.CallActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MenuApp" />
        
        <activity
            android:name=".wallet.WalletActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp" />
        
        <activity
            android:name=".profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp" />
        
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp" />
        
        <activity
            android:name=".notifications.NotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.MenuApp" />
        
        <!-- Firebase Messaging Service -->
        <service
            android:name=".firebase.FirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".calling.CallKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
