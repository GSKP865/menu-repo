<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.MenuApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryDark">@color/purple_dark</item>
        <item name="colorAccent">@color/purple_accent</item>
        
        <item name="bottomNavigationStyle">@style/LightGlassNavigation</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">#F5F8F3</item>
        <item name="android:navigationBarColor">#F5F8F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Action bar -->
        <item name="actionBarStyle">@style/ActionBarStyle</item>
    </style>
    
    <style name="ActionBarStyle" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/purple_primary</item>
        <item name="titleTextStyle">@style/ActionBarTitleText</item>
    </style>
    
    <style name="ActionBarTitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <!-- Button Styles -->
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>
    
    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/purple_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/purple_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <!-- Input Field Styles -->
    <style name="InputField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/purple_primary</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="hintTextColor">@color/purple_primary</item>
    </style>
    
    <!-- Card Styles -->
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/glass_white</item>
    </style>
    
    <!-- Text Styles -->
    <style name="DisplayText" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="HeadingText" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="BodyText" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="ButtonText" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="OtpDigitBox" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.MenuApp.Auth" parent="Theme.MenuApp">
        <item name="android:statusBarColor">#F5F8F3</item>
        <item name="android:navigationBarColor">#F5F8F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">#206266</item>
        <item name="colorAccent">#206266</item>
        <item name="android:windowBackground">#F5F8F3</item>
    </style>

    <style name="LightGlassNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/bg_glass_navigation</item>
        <item name="itemIconTint">@color/navigation_tint</item>
        <item name="itemTextColor">@color/navigation_tint</item>
        <item name="elevation">0dp</item>
    </style>
    <!-- Splash Theme with dark background matching brand image -->
    <style name="Theme.MenuApp.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">#080714</item>
        <item name="android:colorBackground">#080714</item>
        <item name="android:statusBarColor">#080714</item>
        <item name="android:navigationBarColor">#080714</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.MenuApp.Profile" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="colorPrimary">#206266</item>
        <item name="android:statusBarColor">#F5F8F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F5F8F3</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.MenuApp.ProfileDark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="colorPrimary">#7BE7D5</item>
        <item name="android:statusBarColor">#162735</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#162735</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
